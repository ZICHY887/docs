<?xml version='1.0' encoding='UTF-8' ?>
<effect id="gm.custom.wave_warp" name="Wave Warp" desc="Horizontal and vertical sine displacement with independent amplitude and frequency." category="custom"
        thumb="content://com.goldmotion.pnkj_com.alightcreative.app.motion.fileprovider/share/gmcustom/wave_warp.png"
        tags="distort,wave,warp,sine" experimental="false">
<params>
<texture id="inputImg" srcType="content" />
<section text="Wave" />
<spinner id="ampX" default="0.02" min="0.0" max="0.2" step="0.001" label="Horizontal Amplitude" />
<spinner id="ampY" default="0.0" min="0.0" max="0.2" step="0.001" label="Vertical Amplitude" />
<spinner id="freqX" default="12.0" min="0.5" max="100.0" step="0.5" label="Horizontal Frequency" />
<spinner id="freqY" default="12.0" min="0.5" max="100.0" step="0.5" label="Vertical Frequency" />
<spinner id="speed" default="1.0" min="0.0" max="10.0" step="0.05" label="Speed" />
<section text="Output" />
<spinner id="mixAmt" default="1.0" min="0.0" max="1.0" step="0.01" label="Effect Strength" />
<section text="GOLD MOTION - CUSTOM FX" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){
  vec2 uv = acScreenNorm;
  float t = acTime * speed * 6.2831853;
  vec2 o;
  o.x = sin(uv.y * freqY + t) * ampX;
  o.y = sin(uv.x * freqX + t) * ampY;
  uv += o * mixAmt;
  gl_FragColor = texture2DCv(inputImg.texture, uv);
}
]]></shader>
</effect>
